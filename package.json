{
  "name": "sketchdex",
  "version": "0.3.0",
  "description": "An MCP server that lets AI agents draw hand-drawn Excalidraw diagrams. Real .excalidraw files on your machine, with history, rendering and a local library app.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "excalidraw",
    "diagram",
    "sketch",
    "whiteboard",
    "claude",
    "codex",
    "cursor",
    "ai-agent"
  ],
  "homepage": "https://sketchdex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasr1b/sketchdex.git"
  },
  "bugs": {
    "url": "https://github.com/lucasr1b/sketchdex/issues"
  },
  "license": "MIT",
  "author": "Lucas Ribeiro",
  "mcpName": "io.github.lucasr1b/sketchdex",
  "type": "module",
  "bin": {
    "sketchdex": "bin/sketchdex"
  },
  "files": [
    "bin/",
    "dist/",
    "BRIEF.md",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,green \"npm:dev:server\" \"npm:dev:ui\"",
    "predev": "node scripts/vendor-fonts.mjs",
    "dev:server": "node scripts/build-server.mjs && nim/bin/sketchdex app --port 5174 --assets dist",
    "dev:ui": "vite",
    "prebuild": "node scripts/vendor-fonts.mjs",
    "build": "tsc -b && vite build",
    "vendor:fonts": "node scripts/vendor-fonts.mjs",
    "build:server": "node scripts/build-server.mjs",
    "lint": "oxlint",
    "test": "node scripts/build-server.mjs && node test/e2e.mjs",
    "test:server:nim": "node scripts/test-server-nim.mjs",
    "test:server": "node scripts/build-server.mjs && node scripts/test-server-nim.mjs && node test/server.e2e.mjs",
    "preview": "vite preview",
    "prepare": "node scripts/patch-excalidraw.mjs && node scripts/vendor-fonts.mjs",
    "prepublishOnly": "npm run lint && npm run build && npm test && node scripts/check-package.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "idb-keyval": "^6.3.0",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
