{
  "name": "sketchdex",
  "version": "0.1.2",
  "description": "An MCP server that lets AI agents draw hand-drawn Excalidraw diagrams. Real .excalidraw files on your machine, with history, rendering and a local library app.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "excalidraw",
    "diagram",
    "sketch",
    "whiteboard",
    "claude",
    "codex",
    "cursor",
    "ai-agent"
  ],
  "homepage": "https://sketchdex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasr1b/sketchdex.git"
  },
  "bugs": {
    "url": "https://github.com/lucasr1b/sketchdex/issues"
  },
  "license": "MIT",
  "author": "Lucas Ribeiro",
  "mcpName": "io.github.lucasr1b/sketchdex",
  "type": "module",
  "bin": {
    "sketchdex": "bin/sketchdex.js"
  },
  "main": "server/agent.js",
  "exports": {
    ".": "./server/agent.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "mcp/",
    "server/",
    "dist/",
    "nim/tests/fixtures/",
    "BRIEF.md",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:core": "node scripts/build-core.mjs",
    "lint": "oxlint",
    "test": "node test/e2e.mjs",
    "test:core": "node scripts/build-core.mjs && node test/core/differential.mjs && node scripts/test-core-nim.mjs && node --test test/core/adapter.test.mjs test/core/normalize.test.mjs test/core/nim-path.test.mjs",
    "test:core:nim": "node scripts/test-core-nim.mjs",
    "bench:core": "node scripts/build-core.mjs && node test/core/benchmark.mjs",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:start": "electron .",
    "app": "npm run build && electron-builder --mac --dir",
    "prepare": "node scripts/patch-excalidraw.mjs",
    "prepublishOnly": "npm run lint && npm run build && node scripts/check-package.mjs && npm test",
    "measure-fonts": "node scripts/measure-fonts.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^40.6.1",
    "electron-builder": "^26.15.3",
    "idb-keyval": "^6.3.0",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.lucas.sketchdex",
    "productName": "Sketchdex",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    }
  }
}
